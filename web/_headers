# Cabeceras de Cloudflare Pages. Lo que no se nombra aquí (HTML, JS, CSS,
# calendarios) se revalida en cada visita para que los cambios lleguen al momento.

# Fuentes: no cambian nunca.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Puzzles y arte: el nombre es un hash del Pokémon y casi nunca cambian.
/data/*/puzzles/*
  Cache-Control: public, max-age=86400
/data/*/art/*
  Cache-Control: public, max-age=86400
